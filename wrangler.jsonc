{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2605d110-7463-491e-abf5-da45c4cdf455","database_name": "web-app1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8bf069c90fa74208a6d41d56f34f96f8" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
